+	-1, 0xac, 0x03, 0x6b,
+	-1, 0xad, 0x03, 0x68,
+	-1, 0xae, 0x03, 0x6c,
+	-1, 0xb3, 0x00,
+	-1, 0xb4, 0x00,
+	-1, 0xb5, 0x00,
+	-1, 0xb6, 0x32,
+	-1, 0xb7, 0x7e,
+	-1, 0xb8, 0x7e,
+
+	-1, 0xe0, 0x00,
+	-1, 0xe1, 0x03, 0x0f,
+	-1, 0xe2, 0x04,
+	-1, 0xe3, 0x01,
