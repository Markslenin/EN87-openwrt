+
+static void set_addr_win(struct fbtft_par *par, int xs, int ys, int xe, int ye)
+{
+	switch (par->info->var.rotate) {
+	case 0:
+		xs += 14;
+		xe += 14;
+		break;
+	case 90:
+		ys += 14;
+		ye += 14;
+		break;
+	case 180:
+		xs += 12;
+		xe += 12;
+		break;
+	case 270:
+		ys += 12;
+		ye += 12;
+		break;
+	}
+
+	write_reg(par, MIPI_DCS_SET_COLUMN_ADDRESS,
+		  xs >> 8, xs & 0xff, xe >> 8, xe & 0xff);
+	write_reg(par, MIPI_DCS_SET_PAGE_ADDRESS,
+		  ys >> 8, ys & 0xff, ye >> 8, ye & 0xff);
+	write_reg(par, MIPI_DCS_WRITE_MEMORY_START);
+}
+
+static int set_var(struct fbtft_par *par)
+{
+	u8 madctl;
+
+	if (madctl_override >= 0) {
+		madctl = madctl_override;
+	} else {
+		switch (par->info->var.rotate) {
+		case 0:
+			madctl = MADCTL_MY | MADCTL_MX;
+			break;
+		case 90:
+			madctl = MADCTL_MX | MADCTL_MV;
+			break;
+		case 180:
+			madctl = 0;
+			break;
+		case 270:
+			madctl = MADCTL_MY | MADCTL_MV;
+			break;
+		default:
+			return 0;
+		}
+		madctl |= par->bgr << 3;
+	}
+
+	write_reg(par, MIPI_DCS_SET_ADDRESS_MODE, madctl);
+	return 0;
+}
+
+static int set_gamma(struct fbtft_par *par, u32 *curves)
+{
+	int i;
+	int j;
+
+	write_reg(par, 0xff, 0xa5);
+	for (i = 0; i < par->gamma.num_curves; i++)
+		for (j = 0; j < par->gamma.num_values; j++)
+			write_reg(par, 0x60 + i * 0x10 + j,
+				  curves[i * par->gamma.num_values + j]);
+	write_reg(par, 0xff, 0x00);
+
+	return 0;
+}
+
+static struct fbtft_display display = {
+	.regwidth = 8,
+	.width = WIDTH,
+	.height = HEIGHT,
+	.gamma_num = 2,
+	.gamma_len = 15,
+	.gamma = DEFAULT_GAMMA,
+	.init_sequence = default_init_sequence,
+	.fbtftops = {
+		.set_addr_win = set_addr_win,
+		.set_var = set_var,
+		.set_gamma = set_gamma,
+	},
+};
+
+FBTFT_REGISTER_DRIVER(DRVNAME, "newvisionu,nv3007", &display);
+
+MODULE_ALIAS("spi:" DRVNAME);
+MODULE_ALIAS("platform:" DRVNAME);
+MODULE_ALIAS("spi:nv3007");
+MODULE_ALIAS("platform:nv3007");
+
+MODULE_DESCRIPTION("FB driver for the NewVision NV3007 LCD Controller");
+MODULE_AUTHOR("HiGoROS-E87N reverse-engineering project");
+MODULE_LICENSE("GPL");
