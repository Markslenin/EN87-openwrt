From: HiGoROS-E87N reverse-engineering project
Subject: [PATCH] staging: fbtft: add fb_nv3007 driver for the NewVision NV3007 LCD controller

This kernel-source-level patch is applied by the
OpenWrt build system to the vanilla Linux 6.6.94 source tree fetched from
kernel.org at build time (target/linux/mediatek/patches-6.6/), per the
usual OpenWrt convention for patches that touch files outside the
buildroot repository itself.

The original E87N kernel implementation was recovered from the ARM64 Image
and used to replace the earlier public-LVGL-derived candidate. See the
project reports for the evidence chain and runtime validation history.
  - the full evidence chain confirming this driver exists (built-in) in
    the original HiGoROS-E87N-1-26-05-09-02 firmware's kernel
    (modules.builtin lists fb_nv3007.ko; the literal strings
    "newvisionu,nv3007" and "fb_nv3007" are present in the decompressed
    kernel Image itself, not just the DTB);
  - the license/provenance review of the register initialization sequence
    (transcribed from lvgl/lvgl, MIT license, which itself credits
    "ArduinoGFX NV3007 driver" — moononournation/Arduino_GFX, BSD
    2-Clause "Adafruit style" license; only the numeric register values
    were carried over, no code structure);
  - historical note from the earlier candidate: no verified hardware-rotation
    (MIPI MADCTL, cmd 0x36) register mapping — intentionally NOT
    implemented at that stage; the current code below now adds set_var().

Kconfig/Makefile diffs below are generated against the real upstream
Linux v6.6 tag content (raw.githubusercontent.com/torvalds/linux/v6.6/
drivers/staging/fbtft/{Kconfig,Makefile}, fetched verbatim, not
paraphrased), verified in an isolated sandbox to apply cleanly and
produce byte-identical results to the intended content before being
folded into this file.

---
 drivers/staging/fbtft/Kconfig    |  6 ++
 drivers/staging/fbtft/Makefile   |  1 +
 drivers/staging/fbtft/fb_nv3007.c | 223 ++++++++++++++++++++++++++++++++++++
 3 files changed, 230 insertions(+)

--- a/drivers/staging/fbtft/Kconfig
+++ b/drivers/staging/fbtft/Kconfig
@@ -89,6 +89,12 @@
 	help
 	  Generic Framebuffer support for ILI9486
 
+config FB_TFT_NV3007
+	tristate "FB driver for the NV3007 LCD Controller"
+	depends on FB_TFT
+	help
+	  Generic Framebuffer support for NV3007
+
 config FB_TFT_PCD8544
 	tristate "FB driver for the PCD8544 LCD Controller"
 	depends on FB_TFT

--- a/drivers/staging/fbtft/Makefile
+++ b/drivers/staging/fbtft/Makefile
@@ -17,6 +17,7 @@
 obj-$(CONFIG_FB_TFT_ILI9341)     += fb_ili9341.o
 obj-$(CONFIG_FB_TFT_ILI9481)     += fb_ili9481.o
 obj-$(CONFIG_FB_TFT_ILI9486)     += fb_ili9486.o
+obj-$(CONFIG_FB_TFT_NV3007)      += fb_nv3007.o
 obj-$(CONFIG_FB_TFT_PCD8544)     += fb_pcd8544.o
 obj-$(CONFIG_FB_TFT_RA8875)      += fb_ra8875.o
 obj-$(CONFIG_FB_TFT_S6D02A1)     += fb_s6d02a1.o

--- /dev/null
+++ b/drivers/staging/fbtft/fb_nv3007.c
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Reconstructed from the fb_nv3007 code in the original E87N kernel Image.
+ * Register values and control flow were recovered from ARM64 code at
+ * kernel Image offsets 0x6f9f08 through 0x6fab68.
+ */
+
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+
+#include <video/mipi_display.h>
+
+#include "fbtft.h"
+
+#define DRVNAME "fb_nv3007"
+#define WIDTH 142
+#define HEIGHT 428
+
+#define MADCTL_MV BIT(5)
+#define MADCTL_MX BIT(6)
+#define MADCTL_MY BIT(7)
+
+#define DEFAULT_GAMMA \
+	"00 02 04 07 05 02 21 23 3A 08 13 13 29 31 0f\n" \
+	"00 02 04 07 05 02 21 23 3A 08 13 13 29 31 0f"
+
+static int madctl_override = -1;
+module_param_named(madctl, madctl_override, int, 0644);
+MODULE_PARM_DESC(madctl,
+		 "Override MIPI MADCTL (0x36); -1 uses the original rotation map");
+
