+	-1, 0xf2, 0x2c, 0x1b, 0x0b, 0x20,
+
+	-1, 0xe9, 0x29,
+	-1, 0xec, 0x04,
+	-1, 0x35, 0x00,
+	-1, 0x44, 0x00, 0x10,
+	-1, 0x46, 0x10,
+
+	/* register page lock */
+	-1, 0xFF, 0x00,
+
+	/* second command list: pixel format, sleep-out, delay, display-on */
+	-1, 0x3a, 0x05,
+	-1, NV3007_SLPOUT,
+	-2, 220,
+	-1, NV3007_DISPON,
+
+	-3
+};
+
+/*
+ * set_addr_win() — standard MIPI DCS column/page address window setup.
+ * This part is NOT panel-specific: it uses the same three generic MIPI DCS
+ * commands (0x2A/0x2B/0x2C) that essentially every fbtft MIPI-style panel
+ * driver in the kernel tree uses (e.g. fb_ili9486.c). No NV3007-specific
+ * assumption is made here beyond "this chip follows the standard MIPI DCS
+ * column/page addressing model", which is consistent with both public
+ * reference sources (both build on a generic MIPI panel base class/driver).
+ */
+static void set_addr_win(struct fbtft_par *par, int xs, int ys, int xe, int ye)
+{
+	write_reg(par, MIPI_DCS_SET_COLUMN_ADDRESS,
+		  xs >> 8, xs & 0xFF, xe >> 8, xe & 0xFF);
+
+	write_reg(par, MIPI_DCS_SET_PAGE_ADDRESS,
+		  ys >> 8, ys & 0xFF, ye >> 8, ye & 0xFF);
+
+	write_reg(par, MIPI_DCS_WRITE_MEMORY_START);
+}
+
+static struct fbtft_display display = {
+	.regwidth = 8,
+	.width = WIDTH,
+	.height = HEIGHT,
+	.init_sequence = default_init_sequence,
+	.fbtftops = {
+		.set_addr_win = set_addr_win,
+	},
+};
+
+FBTFT_REGISTER_DRIVER(DRVNAME, "newvisionu,nv3007", &display);
+
+MODULE_ALIAS("spi:" DRVNAME);
+MODULE_ALIAS("platform:" DRVNAME);
+MODULE_ALIAS("spi:nv3007");
+MODULE_ALIAS("platform:nv3007");
+
+MODULE_DESCRIPTION("FB driver for the NewVision NV3007 LCD Controller");
+MODULE_AUTHOR("HiGoROS-E87N reverse-engineering project");
+MODULE_LICENSE("GPL");
