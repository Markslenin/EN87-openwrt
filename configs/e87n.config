# EdgePi E87N reproducible image seed.
# Board-specific and practical default packages are maintained in
# Device/edgepi_e87n in target/linux/mediatek/image/filogic.mk.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_edgepi_e87n=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
