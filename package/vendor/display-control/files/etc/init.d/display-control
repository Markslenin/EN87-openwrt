#!/bin/sh /etc/rc.common

START=10
STOP=10
USE_PROCD=1

SERVICE_NAME="display"
HELPER="/usr/sbin/display-control"

feature_enabled() {
	case "$(uci -q get display.settings.enabled 2>/dev/null)" in
		0|off|false|no|disabled) return 1 ;;
		*) return 0 ;;
	esac
}

start_service() {
	[ -x "$HELPER" ] || return 0

	"$HELPER" cleanup-cron >/dev/null 2>&1 || true

	if ! feature_enabled; then
		"$HELPER" off >/dev/null 2>&1 || true
		return 0
	fi

	procd_open_instance
	procd_set_param command "$HELPER" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	"$HELPER" off >/dev/null 2>&1 || true
	killall "$SERVICE_NAME" >/dev/null 2>&1 || true
	killall display-e87n >/dev/null 2>&1 || true
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger display
}
