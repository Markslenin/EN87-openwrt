#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1

NAME=fancontrol
PROG=/usr/bin/$NAME

resolve_pwmfan_paths() {
	local name hwmon

	for name in /sys/class/hwmon/hwmon*/name; do
		[ -r "$name" ] || continue
		[ "$(cat "$name" 2>/dev/null)" = "pwmfan" ] || continue

		hwmon="${name%/name}"
		[ -e "$hwmon/pwm1" ] || continue

		# hwmon numbering depends on probe order and is not stable.
		# Runtime UCI deltas let the daemon consume the live paths.
		uci -q set fancontrol.settings.fan_file="$hwmon/pwm1"
		if [ -r "$hwmon/fan1_input" ]; then
			uci -q set fancontrol.settings.fan_rpm_file="$hwmon/fan1_input"
			uci -q set fancontrol.settings.rpm_supported='1'
		else
			# The E87N factory FDT exposes only the PWM output.  Do not leave a
			# stale hwmon path that suggests tachometer RPM is available.
			uci -q delete fancontrol.settings.fan_rpm_file
			uci -q set fancontrol.settings.rpm_supported='0'
			logger -t fancontrol \
				"RPM unavailable: pwm-fan has no tachometer IRQ/fan1_input"
		fi
		return 0
	done

	logger -t fancontrol "pwmfan hwmon device not found"
	return 1
}

apply_mode_curve() {
	local mode curve

	config_get mode settings mode 1
	case "$mode" in
		0) config_get curve settings curve_silent ;;
		2) config_get curve settings curve_performance ;;
		*) config_get curve settings curve_balanced ;;
	esac

	[ -n "$curve" ] && uci -q set fancontrol.settings.curve="$curve"
}

start_service() {
	local enable mode

	resolve_pwmfan_paths || return 1
	config_load "$NAME"
	apply_mode_curve

	config_get enable settings enable
	[ "$enable" = "1" ] || {
		echo "Instance \"$NAME\" disabled."
		return 1
	}

	config_get mode settings mode

	procd_open_instance
	procd_set_param command "$PROG"
	[ -n "$mode" ] && procd_append_param command -M "$mode"
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger fancontrol
}

extra_command "rpm_status" "Show fan tachometer capability and current RPM"

rpm_status() {
	local name hwmon

	for name in /sys/class/hwmon/hwmon*/name; do
		[ -r "$name" ] || continue
		[ "$(cat "$name" 2>/dev/null)" = "pwmfan" ] || continue
		hwmon="${name%/name}"
		if [ -r "$hwmon/fan1_input" ]; then
			printf 'supported: %s RPM\n' "$(cat "$hwmon/fan1_input")"
			return 0
		fi
		echo "unsupported: this device exposes PWM control but no tachometer input"
		return 2
	done

	echo "unavailable: pwm-fan hwmon device not found"
	return 1
}
