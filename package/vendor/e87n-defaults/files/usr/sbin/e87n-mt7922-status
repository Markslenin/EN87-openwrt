#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -u

device=/sys/bus/pci/devices/0000:01:00.0
device_real="$(readlink -f "$device" 2>/dev/null || true)"
wait_seconds=0
[ "${1:-}" = "--wait" ] && wait_seconds="${2:-90}"

probe() {
	failed=0
	vendor="$(cat "$device/vendor" 2>/dev/null || true)"
	pci_device="$(cat "$device/device" 2>/dev/null || true)"
	driver="$(basename "$(readlink -f "$device/driver" 2>/dev/null)" 2>/dev/null || true)"
	[ "$vendor" = 0x14c3 ] && [ "$pci_device" = 0x0616 ] || failed=1
	[ "$driver" = mt7921e ] || failed=1

	phy=
	for candidate in /sys/class/ieee80211/*; do
		[ -e "$candidate/device" ] || continue
		case "$(readlink -f "$candidate/device")" in
			"$device_real"|"$device_real"/*) phy="${candidate##*/}"; break ;;
		esac
	done
	[ -n "$phy" ] || failed=1

	printf 'pci_id=%s:%s\n' "${vendor#0x}" "${pci_device#0x}"
	printf 'driver=%s\n' "${driver:-unbound}"
	printf 'phy=%s\n' "${phy:-missing}"
	return "$failed"
}

elapsed=0
while ! output="$(probe)"; do
	[ "$elapsed" -ge "$wait_seconds" ] && { printf '%s\n' "$output"; exit 1; }
	sleep 2
	elapsed=$((elapsed + 2))
done
printf '%s\n' "$output"
phy="$(printf '%s\n' "$output" | sed -n 's/^phy=//p')"

radio="$(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)\.path='.*0000:01:00.0.*'/\1/p" | head -n 1)"
if [ -n "$radio" ]; then
	printf 'wireless.country=%s\n' "$(uci -q get wireless."$radio".country || echo unset)"
	printf 'wireless.channel=%s\n' "$(uci -q get wireless."$radio".channel || echo unset)"
	printf 'wireless.htmode=%s\n' "$(uci -q get wireless."$radio".htmode || echo unset)"
	printf 'wireless.txpower_ceiling_dbm=%s\n' "$(uci -q get wireless."$radio".txpower || echo auto)"
fi

if [ -n "$phy" ]; then
	ifname="$(iw dev 2>/dev/null | awk '/Interface / { name=$2 } /wiphy / { if ($2 == 0 && name != "") { print name; exit } }')"
	[ -n "$ifname" ] || ifname="$(iw dev 2>/dev/null | awk '/Interface / { print $2; exit }')"
	if [ -n "$ifname" ]; then
		reported="$(iw dev "$ifname" info 2>/dev/null | awk '/txpower/ { print $2; exit }')"
		printf 'wireless.txpower_reported_dbm=%s\n' "${reported:-unavailable}"
	fi
fi

for module in mt76 mt76_connac_lib mt792x_lib mt7921_common mt7921e; do
	if [ -d "/sys/module/$module" ]; then
		echo "module.$module=loaded"
	else
		echo "module.$module=missing"
		exit 1
	fi
done

for firmware in \
	WIFI_MT7961_patch_mcu_1_2_hdr.bin WIFI_RAM_CODE_MT7961_1.bin \
	WIFI_MT7922_patch_mcu_1_1_hdr.bin WIFI_RAM_CODE_MT7922_1.bin; do
	if [ -f "/lib/firmware/mediatek/$firmware" ]; then
		echo "firmware.$firmware=present"
	else
		echo "firmware.$firmware=missing"
		exit 1
	fi
done
