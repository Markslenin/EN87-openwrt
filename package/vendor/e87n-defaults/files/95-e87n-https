# SPDX-License-Identifier: GPL-2.0-or-later

# uhttpd ships with HTTPS examples commented out. Enable both address families
# only when the administrator has not already supplied an HTTPS listener.
if [ -z "$(uci -q get uhttpd.main.listen_https)" ]; then
	uci -q add_list uhttpd.main.listen_https='0.0.0.0:443'
	uci -q add_list uhttpd.main.listen_https='[::]:443'
	uci -q commit uhttpd
fi

exit 0
